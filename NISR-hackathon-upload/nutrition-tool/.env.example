# Copy this file to .env and fill in real values.
# Do NOT commit the real .env file to git.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=umurima_nutrition
DB_USER=root
DB_PASS=changeme

# Optional â€” only needed for hosts that require SSL (e.g. Aiven, PlanetScale).
# Leave DB_SSL_ENABLED=false for local MySQL/MariaDB.
DB_SSL_ENABLED=false
DB_SSL_CA=
# Set to false only if you hit Aiven's known cert/hostname mismatch on
# older mysqlnd builds. Leave true otherwise.
DB_SSL_VERIFY_CERT=true

# Optional admin-only local PDF text extraction.
# Poppler is not required when using LlamaParse for AI parsing.
PDFTOTEXT_BIN=pdftotext
# Optional: direct PDF parsing with LlamaParse (PDF pages are sent to LlamaCloud).
LLAMA_CLOUD_API_KEY=
# Optional: transcribe extracted text into draft JSON with Gemini.
# Review Google's current API terms/privacy before enabling; keep the key server-side.
GEMINI_API_KEY=
# Optional fallback for transient Gemini capacity/rate-limit errors.
# Groq receives extracted text, not the PDF document.
GROQ_API_KEY=

# Optional: choose an active Groq model available to your account.
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: free USDA FoodData Central API key for reviewed nutrient imports.
# Keep this key private and never commit nutrition-tool/.env.
USDA_FDC_API_KEY=